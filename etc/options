(* :mode=isabelle-options: *)

option pide_mcp_exit_on_failed_option_sessions : bool = true for pide_mcp
  -- "exit when a session specified in options fails to start"

option pide_mcp_await_option_sessions : bool = true for pide_mcp
  -- "await sessions specified in options before starting the MCP server"

option pide_mcp_range_context : int = 50 for pide_mcp
  -- "lines around a read or edited range that are marked visible"

option pide_mcp_session_progress_delay : real = 5.0 for pide_mcp
  -- "delay for progress messages of potentially blocking PIDE session operations (seconds)"

option pide_mcp_progress_threshold : real = 20 for pide_mcp
  -- "threshold for long-running commands (seconds)"

option pide_mcp_session_statistics_limit : int = 200 for pide_mcp
  -- "maximum number of buffered runtime statistics samples per session"

option pide_mcp_sync_diff_dir : string = ".pide_mcp/sync_diffs" for pide_mcp
  -- "directory for unified diffs of external edits that were synchronised from disk (empty: no diffs written); a relative path is relative to the working directory of the server, i.e. the project; the directory ignores itself in git; only the file name is reported to the agent"

option pide_mcp_tools : string = "*" for pide_mcp
  -- "comma-separated names of tools to serve or \"*\" to serve all"

option pide_mcp_auto_inspect : bool = true for pide_mcp
  -- "inspect slow or failed apply/by steps automatically with apply_inspect (HOL-based sessions)"

option pide_mcp_auto_inspect_after : real = 5.0 for pide_mcp
  -- "inspect an apply/by step that is still running after this many seconds (failed steps at once)"

option pide_mcp_auto_inspect_facts : bool = false for pide_mcp
  -- "auto-inspect also lists possibly relevant facts (Sledgehammer's relevance filter) for a failing goal"

option pide_mcp_auto_inspect_timeout : int = 5 for pide_mcp
  -- "method timeout of an automatic inspection (seconds)"

option pide_mcp_step_time_limit : real = 5.0 for pide_mcp
  -- "interrupt a proof step (apply, by, proof, qed, done, ., ..) whose real run reaches this many seconds (0: no limit); retry_without_limit runs it again without"

option pide_mcp_cost_guard_ratio : real = 0.5 for pide_mcp
  -- "hold an edit or disk change that makes Isabelle run again more than this part of the time of the theory and the theories importing it (0: no guard)"

option pide_mcp_cost_guard_floor : real = 10.0 for pide_mcp
  -- "... and at least this many seconds"

option pide_mcp_possibly_looping_after : real = 30.0 for pide_mcp
  -- "label a command still_running_possibly_nonterminating once its real run has taken this many seconds (before: running)"

option pide_mcp_qualify_names : string = "notation" for pide_mcp
  -- "print constants with their full name in the MCP's output: notation (a constant whose notation is a single word, or whose plain name shadows a base-session constant, e.g. a project's map), outside_base (also constants of theories outside the base sessions), all, none"
